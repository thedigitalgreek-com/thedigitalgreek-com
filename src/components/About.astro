---
import { Image } from "astro:assets";
import Email from "./Email.astro";
import { contact, core, toolkit, team } from "../data/site";
---

<section id="about" class="wrap scroll-mt-8 pt-32">
  <div class="grid grid-cols-12 gap-x-6 gap-y-16">
    <div class="col-span-12 md:col-span-7">
      <p class="font-mono text-meta text-muted">About</p>
      <h2 class="mt-4 text-title">A small digital agency in Berlin.</h2>
      <div class="mt-8 space-y-7">
        <p>
          We use open-source software, clear strategy and careful design to
          build fast, SEO-optimized websites and apps.
        </p>
        <p>
          We care about the parts most people never notice: semantic,
          accessible markup built to W3C standards, sites that work in every
          browser, good typography and a mobile UX that feels right.
        </p>
        <p>
          Speed comes first. We keep an eye on Core Web Vitals, add structured
          data the way Google expects and build for search from day one.
        </p>
        <p>
          Spyros has been a front-end developer for more than 15 years. Right
          now he also works for MM New Media GmbH in Leipzig.
        </p>
      </div>

      <ul class="mt-12 grid grid-cols-2 gap-6">
        {
          team.map((m) => (
            <li class="flex items-center gap-4">
              <Image
                src={m.photo}
                alt={`Portrait of ${m.name}`}
                width={256}
                class="size-20 shrink-0 rounded-full object-cover grayscale md:size-32"
              />
              <div>
                <p class="leading-snug">{m.name}</p>
                <p class="font-mono text-meta text-muted">{m.role}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="col-span-12 md:col-span-4 md:col-start-9">
      <h2 class="font-mono text-meta text-muted">Contact</h2>
      <ul class="mt-4">
        <li class="flex justify-between gap-4 border-t border-line py-2">
          <span class="text-muted">Email</span>
          <Email />
        </li>
        {
          contact.map((c) => (
            <li class="flex justify-between gap-4 border-t border-line py-2 last:border-b">
              <span class="text-muted">{c.label}</span>
              <a href={c.href} rel="me noopener noreferrer" target="_blank">
                {c.text} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="col-span-12">
      <p class="font-mono text-meta text-muted">Core stack</p>
      <h2 class="mt-4 text-title">{core.join(", ")}</h2>
    </div>

    <div class="col-span-12">
      <h2 class="font-mono text-meta text-muted">Full toolkit</h2>
      <dl class="mt-4 border-b border-line">
        {
          toolkit.map((t) => (
            <div class="grid grid-cols-12 gap-x-6 border-t border-line py-2">
              <dt class="col-span-12 font-mono text-meta leading-7 text-muted md:col-span-3">
                {t.label}
              </dt>
              <dd class="col-span-12 md:col-span-9">{t.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
