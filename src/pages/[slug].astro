---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = (
    await getCollection("projects", (p) => !p.data.placeholder)
  ).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  next: CollectionEntry<"projects">;
}
const { project, next } = Astro.props;
const { title, description, client, role, year, url, shots } = project.data;

const details = [
  ["Client", client],
  ["Role", role],
  ["Year", year],
].filter(([, v]) => v) as [string, string][];
const desktop = shots.filter((s) => s.device === "desktop");
const mobile = shots.filter((s) => s.device === "mobile");

// Share image and structured data for this project.
const site = Astro.site!.href;
const pageUrl = new URL(`/${project.id}/`, site).href;
const cover = desktop[0] ?? shots[0];
const ogImage = cover
  ? (await getImage({ src: cover.src, width: 1200, height: 630, fit: "cover", position: "top", format: "jpg" })).src
  : undefined;
const schema = [
  {
    "@type": "CreativeWork",
    "@id": `${pageUrl}#work`,
    name: title,
    description,
    url: pageUrl,
    ...(ogImage && { image: new URL(ogImage, site).href }),
    ...(/^\d{4}/.test(year) && { dateCreated: year.slice(0, 4) }),
    ...(url && { sameAs: url }),
    creator: { "@id": `${site}#org` },
    inLanguage: "en",
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Work", item: new URL("/#work", site).href },
      { "@type": "ListItem", position: 2, name: title, item: pageUrl },
    ],
  },
];
---

<Base title={title} description={description} image={ogImage} imageAlt={cover?.alt} schema={schema}>
  <article
    class="wrap grid grid-cols-12 items-start gap-x-6 gap-y-12 pt-16 md:pt-24"
  >
    <div class="col-span-12 md:sticky md:top-8 md:col-span-4">
      <h1 class="text-title">{title}</h1>
      <p class="mt-7">{description}</p>

      <dl
        class="mt-8 grid grid-cols-[6rem_1fr] gap-x-2 border-t border-line pt-4 font-mono text-meta"
      >
        {
          details.map(([k, v]) => (
            <>
              <dt class="text-muted">{k}</dt>
              <dd>{v}</dd>
            </>
          ))
        }
      </dl>

      {
        url && (
          <a
            class="mt-8 inline-block border-b border-current"
            href={url}
            rel="noopener noreferrer"
            target="_blank"
          >
            Visit live site ↗
          </a>
        )
      }
    </div>

    <div class="col-span-12 grid gap-6 md:col-span-7 md:col-start-6">
      {
        desktop.map((s, i) => (
          <Image
            src={s.src}
            alt={s.alt}
            widths={[720, 1080, 1440, 2160]}
            sizes="(min-width: 768px) 58vw, 100vw"
            loading={i === 0 ? "eager" : "lazy"}
            class="w-full shadow-[0_0_0_1px_var(--line)]"
          />
        ))
      }
      {
        mobile.length > 0 && (
          <div class="grid grid-cols-2 gap-6 sm:grid-cols-3">
            {mobile.map((s) => (
              <Image
                src={s.src}
                alt={s.alt}
                widths={[390, 780]}
                sizes="(min-width: 768px) 18vw, 45vw"
                loading="lazy"
                class="w-full shadow-[0_0_0_1px_var(--line)]"
              />
            ))}
          </div>
        )
      }
    </div>
  </article>

  <nav class="wrap mt-24" aria-label="Projects">
    <div class="flex justify-between gap-4 border-t border-line pt-4">
      <a class="font-mono text-meta text-muted" href="/#work">← All work</a>
      {
        next.id !== project.id && (
          <a href={`/${next.id}`}>Next: {next.data.title} →</a>
        )
      }
    </div>
  </nav>
</Base>
